{
    email {{ caddy_email }}
}

{% for site in caddy_sites %}
{{ site.domain }} {
    encode zstd gzip

    reverse_proxy {{ site.upstream }} {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Port {server_port}
    }

    log {
        output file /var/log/caddy/{{ site.domain }}.log {
            roll_size 10MB
            roll_keep 5
        }
    }
}
{% endfor %}